{
  "name": "kiwi",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first Windows research workspace",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.12.0"
  },
  "scripts": {
    "preflight": "node tooling/scripts/preflight.mjs",
    "check:fixtures": "node tooling/scripts/check-fixtures.mjs",
    "setup": "node tooling/scripts/preflight.mjs && pnpm install",
    "predev": "docker compose -f apps/service/compose.dev.yml up -d --wait",
    "dev": "turbo run dev --filter=@kiwi/service --filter=@kiwi/desktop",
    "dev:service": "pnpm --filter @kiwi/service dev",
    "verify": "node tooling/scripts/preflight.mjs && pnpm run format:check && turbo run lint typecheck test:unit && node tooling/scripts/check-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "schema:check": "turbo run schema:check",
    "docs:check": "turbo run docs:check",
    "package": "turbo run package --filter=@kiwi/desktop",
    "site": "pnpm --filter @kiwi/site run site"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
