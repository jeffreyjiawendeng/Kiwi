KIWI_DATABASE_URL=postgresql://kiwi:kiwi-local-development-only@127.0.0.1:54329/kiwi
KIWI_SERVICE_HOST=127.0.0.1
KIWI_SERVICE_PORT=4319
KIWI_SERVICE_ENV=development
KIWI_PUBLIC_ORIGIN=http://127.0.0.1:4319
KIWI_AUTH_FIXTURES=1
KIWI_GOOGLE_AUTH_FIXTURE=0
KIWI_GOOGLE_CLIENT_ID=
KIWI_GOOGLE_CLIENT_SECRET=
KIWI_SMTP_HOST=
# 465 negotiates TLS immediately. 587 and 2525 open in the clear and are upgraded with
# STARTTLS before anything secret is sent. The port decides which is used, so set
# KIWI_SMTP_SECURITY only for a provider that does not follow that convention.
KIWI_SMTP_PORT=465
KIWI_SMTP_SECURITY=
KIWI_SMTP_USERNAME=
KIWI_SMTP_PASSWORD=
KIWI_EMAIL_FROM=
KIWI_ORCID_CLIENT_ID=
KIWI_ORCID_CLIENT_SECRET=
KIWI_ORCID_SANDBOX=1
KIWI_GITHUB_CLIENT_ID=
KIWI_GITHUB_CLIENT_SECRET=
KIWI_ZOTERO_CLIENT_ID=
KIWI_ZOTERO_CLIENT_SECRET=
KIWI_MENDELEY_CLIENT_ID=
KIWI_MENDELEY_CLIENT_SECRET=
KIWI_OSF_CLIENT_ID=
KIWI_OSF_CLIENT_SECRET=
KIWI_FIGSHARE_CLIENT_ID=
KIWI_FIGSHARE_CLIENT_SECRET=
KIWI_ZENODO_CLIENT_ID=
KIWI_ZENODO_CLIENT_SECRET=
KIWI_CONNECTION_ENCRYPTION_KEY=
# Development defaults are 30, 30, 90, and 365 days respectively. Production requires explicit
# values from 1 through 3650.
KIWI_AUTH_ARTIFACT_RETENTION_DAYS=
KIWI_DELIVERED_EMAIL_RETENTION_DAYS=
KIWI_NOTIFICATION_RETENTION_DAYS=
KIWI_SECURITY_EVENT_RETENTION_DAYS=
