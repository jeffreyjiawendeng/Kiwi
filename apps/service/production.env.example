# Kiwi hosted service. Copy values into the deployment secret manager; do not use this file as a
# secret store and do not place a completed copy in the repository.
KIWI_SERVICE_ENV=production
KIWI_SERVICE_HOST=0.0.0.0
KIWI_SERVICE_PORT=4319
KIWI_PUBLIC_ORIGIN=
KIWI_DATABASE_URL=

# Development adapters are always disabled in production.
KIWI_AUTH_FIXTURES=0
KIWI_GOOGLE_AUTH_FIXTURE=0

# Required account methods.
KIWI_GOOGLE_CLIENT_ID=
KIWI_GOOGLE_CLIENT_SECRET=
KIWI_SMTP_HOST=
KIWI_SMTP_PORT=465
KIWI_SMTP_USERNAME=
KIWI_SMTP_PASSWORD=
KIWI_EMAIL_FROM=

# Stable 32-byte key encoded as base64. Back it up with the database.
KIWI_CONNECTION_ENCRYPTION_KEY=

# Retention in whole days (1 through 3650). These apply only to account-service operational
# records, never canonical workspace or research content.
#
# PRIVACY.md publishes these exact numbers to users. Changing one here without changing the
# policy makes the published policy false, so change both together.
KIWI_AUTH_ARTIFACT_RETENTION_DAYS=30
KIWI_DELIVERED_EMAIL_RETENTION_DAYS=30
KIWI_NOTIFICATION_RETENTION_DAYS=90
KIWI_SECURITY_EVENT_RETENTION_DAYS=365

# ORCID sign-in and every connected-account provider are deferred and are not reachable from the
# application. Leave them unset. See docs/deferred-authentication-and-connections.md for what has
# to be true before one is brought back.
