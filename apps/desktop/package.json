{
  "name": "@kiwi/desktop",
  "productName": "Kiwi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Kiwi desktop application",
  "main": "./dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.worker.config.ts && vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --build tsconfig.build.json && tsc --project tsconfig.test.json",
    "lint": "eslint src",
    "test:unit": "vitest run --project main --project renderer",
    "test:integration": "vitest run --project bundle --project integration",
    "prepackage": "node scripts/service-config.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@kiwi/commands": "workspace:*",
    "@kiwi/contracts": "workspace:*",
    "@kiwi/diagnostics": "workspace:*",
    "@kiwi/testkit": "workspace:*",
    "@kiwi/workspace": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/katex": "^0.16.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "jsdom": "30.0.1",
    "katex": "^0.18.4",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "author": "The Kiwi Authors"
}
